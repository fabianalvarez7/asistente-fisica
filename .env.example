# Groq API key para el LLM (https://console.groq.com)
GROQ_API_KEY=

# Dispositivo para los embeddings locales
# - auto: detecta MPS (Mac Apple Silicon) / CUDA (Windows con GPU) / CPU
# - mps: forzar MPS
# - cuda: forzar CUDA
# - cpu: forzar CPU
EMBEDDINGS_DEVICE=auto

# Persistencia de ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# Persistencia de SQLite (historial de conversaciones)
SQLITE_PATH=./data/historial.db

# Modelo de Groq (placeholder, se confirma en mes 2)
LLM_MODEL=llama-3.3-70b-versatile
