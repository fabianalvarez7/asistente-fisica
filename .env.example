# Groq API key para el LLM (https://console.groq.com).
# En HF Spaces se configura como Secret desde la UI; nunca se commitea.
GROQ_API_KEY=

# Dispositivo para los embeddings locales
# - auto: detecta MPS (Mac Apple Silicon) / CUDA (Windows con GPU) / CPU
# - mps: forzar MPS
# - cuda: forzar CUDA
# - cpu: forzar CPU
EMBEDDINGS_DEVICE=auto

# Persistencia de ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# Persistencia de SQLite (historial de conversaciones)
SQLITE_PATH=./data/historial.db

# Cache local del modelo de embeddings (pre-bakeado en rag/index/hf-model para HF Spaces)
HF_HOME=./rag/index/hf-model
SENTENCE_TRANSFORMERS_HOME=./rag/index/hf-model

# Mitigación de uso de CPU/memoria en el contenedor de HF Spaces
OMP_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# Ventana de historial inyectada en el prompt de Groq (en mensajes).
# 0 desactiva la inyección de historial y restaura el comportamiento de un solo turno.
HISTORY_WINDOW=10

# Modo producción. Si está definido, suprime el volcado de mensajes en consola
# que se usa para revisión manual en desarrollo.
# PRODUCTION=true

# Modelo de Groq (confirmado para el prototipo)
LLM_MODEL=llama-3.3-70b-versatile
