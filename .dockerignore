# Build context exclusions. HF Spaces builds from the Space repo (no .venv
# or local dev artifacts), but a local `docker build .` would otherwise copy
# 1.5 GB of .venv/ into the build context. Mirror of .gitignore plus a few
# deploy-specific exclusions.

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python build/cache artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Environment / secrets
.env
.env.local
.env.*.local

# Dev data (ChromaDB, SQLite, source PDFs) — never baked into image
data/
material-fisica/

# HF hub cache: huggingface_hub creates this when downloading a model.
# The actual model weights live in the LFS-tracked snapshot dir above
# (rag/index/hf-model/models--intfloat--multilingual-e5-small/snapshots/...);
# this hub/ cache is a duplicate and can grow to ~478 MB. Never commit.
rag/index/hf-model/hub/

# IDEs / editors / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# OpenCode / orchestrator local caches
.atl/
.Rhistory
*.ipynb
.ipynb_checkpoints/

# Streamlit / Jupyter
.streamlit/secrets.toml

# Git internals
.git/
.gitignore
.gitattributes
